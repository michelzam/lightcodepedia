{
  "name": "@karmicsoft/lc-gateway",
  "version": "0.1.0",
  "private": false,
  "description": "E-mail sign-in and pull-request writer for git-backed content — one contribution, one branch, one pull request. A LightCode brick, shipped as a container.",
